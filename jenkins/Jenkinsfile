// CommitSleuth pipeline. Jenkins job: "Pipeline script from SCM", Script Path = jenkins/Jenkinsfile
// EDIT the CS_DB path below to the real location of database/commitsleuth.db on this machine.
def run(cmd) { if (isUnix()) { sh cmd } else { bat cmd } }

pipeline {
  agent any
  environment {
    CS_DB = '/ABSOLUTE/PATH/TO/CommitSleuth/database/commitsleuth.db'
  }
  stages {
    stage('Checkout') { steps { checkout scm } }
    stage('Build') {
      steps { run('mvn -B -f maven/pom.xml clean compile > build.log 2>&1') }
    }
    stage('Test') {
      steps { run('mvn -B -f maven/pom.xml test >> build.log 2>&1') }
    }
    stage('Promote to Testing') {
      when { expression { env.GIT_BRANCH ==~ /.*release\/.*/ } }
      steps { run("python analyzer/promote.py --from Development --to Testing --approver BKS --tests-passed") }
    }
    stage('Promote to Production') {
      when { expression { env.GIT_BRANCH ==~ /.*main/ } }
      steps { run("python analyzer/promote.py --from Testing --to Production --approver BKS --tests-passed") }
    }
  }
  post {
    success { run("python analyzer/record_build.py --result SUCCESS --build ${env.BUILD_NUMBER}") }
    failure { run("python analyzer/record_build.py --result FAILURE --build ${env.BUILD_NUMBER} --log build.log") }
    always  { archiveArtifacts artifacts: 'build.log', allowEmptyArchive: true }
  }
}
